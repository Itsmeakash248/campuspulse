# CampusPulse environment
# Copy this file to .env and fill in your Supabase project values.

PORT=3000

# Project Settings -> API -> Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings -> API -> service_role secret
# Server-only. Never put this key in public/ or in frontend JavaScript.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional and NOT used by the Express server.
# Only needed if you later add a browser-side Supabase client.
SUPABASE_ANON_KEY=your-anon-key

# Gemini AI incident triage (server-only)
# Get a key from Google AI Studio -> API keys.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-4-hydrogen
